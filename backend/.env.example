APP_NAME=DocIntel AI
ENVIRONMENT=development

# Path to the Firebase Admin SDK service account JSON (never commit the real file)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=

# Comma-separated list of allowed Angular origins
CORS_ORIGINS=http://localhost:4200

# AI provider selection: "openai" (OpenAI-compatible API) or "ollama" (local models)
AI_PROVIDER=ollama

# OpenAI-compatible provider (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama provider (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.4
