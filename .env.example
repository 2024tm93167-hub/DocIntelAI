# DocIntel AI — root environment reference.
#
# The Angular frontend does NOT read a .env file. Its configuration lives in
# frontend/src/environments/environment.ts (and environment.development.ts).
# Firebase Web config there is not secret (it is public by design and is
# protected by Firebase security rules / backend authorization), but the
# values are project-specific and must be filled in from the Firebase Console
# (Project Settings > General > Your apps > Web app).
#
# The FastAPI backend reads its configuration from backend/.env — copy
# backend/.env.example to backend/.env and fill in the values below.

# ---- Backend (backend/.env) ----
APP_NAME=DocIntel AI
ENVIRONMENT=development

FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=

CORS_ORIGINS=http://localhost:4200

AI_PROVIDER=ollama

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.4
