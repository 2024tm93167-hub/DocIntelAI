[Unit]
Description=DocIntel AI FastAPI backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/docintel/backend
EnvironmentFile=/home/ubuntu/docintel/backend/.env
ExecStart=/home/ubuntu/docintel/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
